# ═══════════════════════════════════════════════════════════════════════
# Environment Variables for Velocity Sniper
# ═══════════════════════════════════════════════════════════════════════
# Copy this file as .env and fill in the values.
# NEVER commit .env to version control.

# Path to configuration file
CONFIG_PATH=config.toml

# Your wallet private key (base58 encoded) — overrides config.toml
# This is the ONLY way the bot signs transactions.
PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY_HERE

# Optional: Helius/QuickNode API key for premium RPC
HELIUS_API_KEY=

# Optional: Discord webhook for trade alerts
DISCORD_WEBHOOK_URL=
